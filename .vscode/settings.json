{
    // 检测嵌套子仓库（例如 练习/爬虫，它位于第 2 层目录）
    "git.repositoryScanMaxDepth": 3,
    "git.autoRepositoryDetection": true,
    // Python 开发专用配置
    "python.defaultInterpreterPath": "${workspaceFolder}/new_env/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "python.linting.enabled": true,
    "python.formatting.provider": "black",
    "editor.formatOnSave": true,
    "python.terminal.runInDedicatedTerminal": true,
    "files.associations": {
        "*.pyx": "cython"
    },
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.latexindent.path": "${workspaceFolder}/.vscode/latexindent_wrapper.cmd",
    "files.exclude": {
        "**/data": true
    },
    "search.exclude": {
        "**/data": true
    },
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "workbench.experimental.modernUIUppercaseViewHeaders": false,
    "workbench.experimental.modernUI": false
}
